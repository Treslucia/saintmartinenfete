---
const siteName = "Saint-Martin-en-Fête";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Le comité des fêtes de Saint-Martin-le-Redon : manifestations, repas, randonnées et rendez-vous conviviaux.",
  image,
  imageAlt = `${siteName} — comité des fêtes de Saint-Martin-le-Redon`,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL(
  image ?? "/images/og-default.jpg",
  Astro.site ?? Astro.url.origin,
).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2f5d3a" />
  </head>

  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/" aria-label={`${siteName} — Accueil`}>
          <img
            src="/images/logo-rectangulaire.png"
            alt={siteName}
          />
        </a>

        <nav aria-label="Navigation principale">
          <a
            href="/"
            class:list={{ active: Astro.url.pathname === "/" }}
            aria-current={Astro.url.pathname === "/" ? "page" : undefined}
          >
            Accueil
          </a>
          <a
            href="/manifestations"
            class:list={{ active: Astro.url.pathname.startsWith("/manifestations") }}
            aria-current={Astro.url.pathname.startsWith("/manifestations") ? "page" : undefined}
          >
            Manifestations
          </a>
          <a
            href="/contact"
            class:list={{ active: Astro.url.pathname === "/contact" }}
            aria-current={Astro.url.pathname === "/contact" ? "page" : undefined}
          >
            Contact
          </a>
        </nav>
      </div>
    </header>

    <main id="contenu" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
<!--	
      <div class="footer-inner">
        <div>
          <strong>{siteName}</strong>
          <p>Le comité des fêtes de Saint-Martin-le-Redon.</p>
        </div>

        <nav aria-label="Navigation du pied de page">
          <a href="/">Accueil</a>
          <a href="/manifestations">Manifestations</a>
          <a href="/contact">Contact</a>
        </nav>

        <div class="footer-contact">
          <strong>Contact</strong>
          <a href="mailto:contact@saintmartinenfete.fr">
            contact@saintmartinenfete.fr
          </a>
        </div>
      </div>
-->
      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} {siteName}</p>
			
		<a href="mailto:contact@saintmartinenfete.fr">
		contact@saintmartinenfete.fr
		</a>

      </div>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    --color-green: #2f5d3a;
    --color-green-dark: #23472c;
    --color-green-soft: #e8efe9;
    --color-cream: #f7f3e9;
    --color-cream-dark: #eee7d8;
    --color-terracotta: #b85c38;
    --color-ink: #252525;
    --color-muted: #5b625d;
    --color-white: #fff;
    --shadow-card: 0 8px 24px rgb(37 37 37 / 8%);
    --radius: 14px;
    --content-width: 1000px;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    color: var(--color-ink);
    background: var(--color-cream);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  :global(img) {
    max-width: 100%;
  }

  :global(a) {
    color: var(--color-green);
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(input:focus-visible),
  :global(select:focus-visible),
  :global(textarea:focus-visible) {
    outline: 3px solid var(--color-terracotta);
    outline-offset: 3px;
    border-radius: 4px;
  }

  :global(.skip-link) {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 1rem;
    transform: translateY(-150%);
    padding: 0.75rem 1rem;
    color: var(--color-white);
    background: var(--color-green-dark);
    font-weight: 700;
    text-decoration: none;
    border-radius: 0 0 8px 8px;
  }

  :global(.skip-link:focus) {
    transform: translateY(0);
  }

  .site-header {
    color: var(--color-white);
    background: var(--color-green);
  }

  .header-inner {
    width: min(100% - 2rem, var(--content-width));
    min-height: 95px;
    margin: 0 auto;
    padding: 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    display: block;
    flex-shrink: 1;
    line-height: 0;
  }

  .logo img {
    display: block;
    width: auto;
    height: 88px;
  }

  .site-header nav,
  .footer-inner nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .site-header nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0.6rem 0.85rem;
    color: var(--color-white);
    text-decoration: none;
    border-radius: 8px;
  }

  .site-header nav a:hover,
  .site-header nav a.active {
    background: rgb(255 255 255 / 16%);
  }

  .site-header nav a.active {
    font-weight: 700;
  }

  .site-main {
    min-height: 70vh;
  }

  .site-footer {
    margin-top: 4rem;
    color: var(--color-white);
    background: var(--color-green-dark);
  }

  .footer-inner {
    width: min(100% - 2rem, var(--content-width));
    margin: 0 auto;
    padding: 2.5rem 0;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.3fr;
    gap: 2rem;
  }

  .footer-inner strong {
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-inner p {
    margin: 0;
    color: rgb(255 255 255 / 78%);
  }

  .footer-inner nav {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-inner nav a,
  .footer-contact a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-white);
    text-decoration: none;
  }

  .footer-inner nav a:hover,
  .footer-contact a:hover {
    text-decoration: underline;
  }
<!--
  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 15%);
    padding: 1rem;
    text-align: center;
  }

  .footer-bottom p {
    color: rgb(255 255 255 / 65%);
    font-size: 0.9rem;
  }
-->
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  max-width: 1200px;
  margin: 0 auto;
}

.footer-bottom p {
  margin: 0;
  color: white;
}

.footer-bottom a {
  color: white;
  font-weight: bold;
  text-decoration: none;
}

.footer-bottom a:hover {
  text-decoration: underline;
  color: var(--color-terracotta);
}


  @media (max-width: 700px) {
    .header-inner {
      width: min(100% - 1.5rem, var(--content-width));
      min-height: 0;
      padding: 0.75rem 0;
      flex-direction: column;
      gap: 0.5rem;
    }

    .logo {
      width: 100%;
      text-align: center;
    }

    .logo img {
      width: min(100%, 380px);
      height: auto;
      margin: 0 auto;
    }

    .site-header nav {
      width: 100%;
    }

    .site-header nav a {
      flex: 1;
      justify-content: center;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      padding: 2rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    :global(*),
    :global(*::before),
    :global(*::after) {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
