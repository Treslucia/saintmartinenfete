---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Saint-Martin-en-Fête"
  description="Contactez Saint-Martin-en-Fête ou retrouvez l'association à la mairie de Saint-Martin-le-Redon."
>
  <section class="contact-page" aria-labelledby="contact-title">
    <header class="page-header">
      <p class="section-kicker">Une question ?</p>
      <h1 id="contact-title">Contact</h1>
      <p>
        Une question, une suggestion ou envie de participer à la vie du
        village ? N'hésitez pas à nous contacter.
      </p>
    </header>

    <div class="contact-grid">
      <section class="contact-card" aria-labelledby="contact-us-title">
        <h2 id="contact-us-title">Nous contacter</h2>

        <p><strong>Saint-Martin-en-Fête</strong></p>

        <p>
          <span aria-hidden="true">✉️</span>
          <a href="mailto:contact@saintmartinenfete.fr">
            contact@saintmartinenfete.fr
          </a>
        </p>

        <a class="contact-button" href="mailto:contact@saintmartinenfete.fr">
          Nous écrire
        </a>

        <div class="social">
          <h2>Suivez-nous</h2>
          <a
            class="facebook-link"
            href="https://www.facebook.com/p/St-Martin-en-F%C3%AAte-100080341640354/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Voir la page Facebook de Saint-Martin-en-Fête"
          >
            <svg class="facebook-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.7 4.533-4.7 1.312 0 2.686.236 2.686.236v2.977h-1.514c-1.491 0-1.956.93-1.956 1.885v2.262h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
              />
            </svg>
          </a>
        </div>
      </section>

      <section class="contact-card" aria-labelledby="find-us-title">
        <h2 id="find-us-title">Nous trouver</h2>

        <p>
          <span aria-hidden="true">📍</span>
          <strong>Association Saint-Martin-en-Fête</strong><br />
          à la mairie<br />
          1 place Saint-Martial<br />
          46700 Saint-Martin-le-Redon
        </p>

        <div class="map">
          <iframe
            title="Localisation de la mairie de Saint-Martin-le-Redon sur OpenStreetMap"
            src="https://www.openstreetmap.org/export/embed.html?bbox=1.0415%2C44.5295%2C1.0445%2C44.5315&layer=mapnik&marker=44.5304603%2C1.0429754"
            loading="lazy"
          ></iframe>
        </div>

        <p class="map-link">
          <a
            href="https://www.openstreetmap.org/way/87534216"
            target="_blank"
            rel="noopener noreferrer"
          >
            Voir la mairie sur OpenStreetMap
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    width: min(100% - 2rem, var(--content-width));
    margin: 0 auto;
    padding: 4rem 0 1rem;
  }

  .page-header {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .section-kicker {
    margin: 0 0 0.5rem;
    color: var(--color-terracotta);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-green);
    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1.1;
  }

  .page-header p:last-child {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: 1.5rem;
  }

  .contact-card {
    padding: clamp(1.5rem, 4vw, 2rem);
    background: white;
    border: 1px solid rgb(47 93 58 / 8%);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }

  .contact-card h2 {
    margin: 0 0 1.25rem;
    color: var(--color-green);
    font-size: 1.4rem;
  }

  .contact-card p {
    line-height: 1.65;
  }

  .contact-card a {
    color: var(--color-green);
    font-weight: 750;
  }

  .contact-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    margin-top: 1rem;
    padding: 0.75rem 1.2rem;
    color: white !important;
    background: var(--color-green);
    border-radius: 9px;
    text-decoration: none;
  }

  .contact-button:hover {
    background: var(--color-green-dark);
  }

  .social {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-cream-dark);
  }

  .facebook-link {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    color: var(--color-green) !important;
    border-radius: 50%;
  }

  .facebook-link:hover {
    color: var(--color-terracotta) !important;
    background: var(--color-green-soft);
  }

  .facebook-icon {
    width: 38px;
    height: 38px;
    fill: currentColor;
  }

  .map {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 10px;
  }

  .map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map-link {
    margin-bottom: 0;
    text-align: right;
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .contact-page {
      padding-top: 2.5rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
