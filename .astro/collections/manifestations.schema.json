{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "repas",
        "randonnee",
        "réunion",
        "autre"
      ]
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "startTime": {
      "type": "string"
    },
    "endTime": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "city": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "city"
      ]
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "registration": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "amount"
        ]
      }
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "open",
        "closed",
        "full",
        "finished"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "date",
    "location",
    "description"
  ]
}